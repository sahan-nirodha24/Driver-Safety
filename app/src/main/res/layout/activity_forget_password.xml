<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111a22"
    tools:context=".forget_password">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_back_arrow"
        android:contentDescription="Go Back"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Forgot Password"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginEnd="52dp"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your email"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We'll send you instructions to reset your password."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_surface_rounded"
            android:hint="Email"
            android:textColorHint="#92adc9"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:textSize="16sp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Send Instructions"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp"
            android:backgroundTint="#1380ec"
            android:layout_marginBottom="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password reset instructions sent to your email. Please check your inbox and follow the steps to reset your password."
            android:textColor="#92adc9"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResend"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:text="Resend Email"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp"
            android:backgroundTint="#233648"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingVertical="0dp"/>

        <TextView
            android:id="@+id/tvContactSupport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Support for Password Issues"
            android:textColor="#92adc9"
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.TextView" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Back to Login"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp"
            android:backgroundTint="#233648"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_gravity="center_horizontal"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>